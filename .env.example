# PostgreSQL connection (Dokploy shows the internal URL on the database page)
DATABASE_URL=postgres://postgres:password@localhost:5432/wolter_parts

# 32+ random characters; signs the admin login cookie. Generate: openssl rand -base64 32
# The app refuses to start in production without a real value.
SESSION_SECRET=

# Public address of the shop (used in Telegram messages and link previews)
SITE_URL=https://parts.wolter.uz

# Where product photos are stored (mount a Docker named volume here)
MEDIA_DIR=/data/media

# First admin account, created only when there are no admins yet (password: 10+ characters).
# Remove ADMIN_PASSWORD after the first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Akmal

# true = fill an empty shop with the 10 sample products from the previews
SEED_DEMO=false

# true = let Google index the shop. Keep false until launch.
ALLOW_INDEXING=false

# true only if parts.wolter.uz is proxied by Cloudflare (orange cloud): then the visitor IP
# comes from the CF-Connecting-IP header. Leave false with "DNS only".
TRUST_CLOUDFLARE=false
